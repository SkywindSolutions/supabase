# Example environment for push_tide_data.py.
# Do not store real secrets in this file.

SOURCE_DATABASE_DSN=postgresql://skywind_user:change-me@127.0.0.1:5432/source_db
SOURCE_QUERY_FILE=/opt/skywind/push_tide_data.sql

SUPABASE_URL=https://dashboard.skywindsolutions.com
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

TARGET_GROUP_ID=grp_clearwater
TARGET_MODEL=tide_hourly
TARGET_LOCID=8726724
TARGET_LOCNAME=Clearwater Beach
TARGET_UNITS=ft

BATCH_SIZE=100
MAX_RETRIES=4
RETRY_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO