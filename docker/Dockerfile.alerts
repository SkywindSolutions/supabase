FROM python:3.12-slim

WORKDIR /app

COPY scripts/requirements-alerts.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/alert_service.py alert_service.py

EXPOSE 8090

CMD ["gunicorn", "--bind", "0.0.0.0:8090", "--workers", "1", "--threads", "2", "--timeout", "120", "--access-logfile", "-", "alert_service:app"]
