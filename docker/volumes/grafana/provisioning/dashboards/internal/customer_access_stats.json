          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(recorded_at, $granularity),\n  INITCAP(REPLACE(REPLACE(grafana_login, 'test_', ''), '_', ' ')) AS metric,\n  COUNT(*) AS value\nFROM public.grafana_access_log\nWHERE $__timeFilter(recorded_at)\n  AND grafana_login NOT LIKE 'test_%'\n  AND grafana_login NOT IN ('dan', 'matt')\nGROUP BY 1, 2\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Customer Access Over Time",
      "type": "timeseries"
