      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  INITCAP(REPLACE(REPLACE(a.grafana_login, 'test_', ''), '_', ' ')) AS \"Account\",\n  CASE WHEN a.grafana_login = 'port_richey' THEN 'grp_portrichey'\n       WHEN a.grafana_login = 'corpus_christi' THEN 'grp_corpuschristi'\n       ELSE 'grp_' || REPLACE(a.grafana_login, 'test_', '')\n  END AS \"Group ID\",\n  MAX(a.last_seen_at) AS \"Last Seen\",\n  COUNT(*) FILTER (WHERE a.recorded_at >= now() - INTERVAL '24 hours') AS \"Last 24h\",\n  COUNT(*) FILTER (WHERE a.recorded_at >= now() - INTERVAL '7 days') AS \"Last 7d\",\n  COUNT(*) FILTER (WHERE a.recorded_at >= now() - INTERVAL '30 days') AS \"Last 30d\",\n  COUNT(*) AS \"Total Events\",\n  MIN(a.recorded_at) AS \"First Seen\"\nFROM public.grafana_access_log a\nWHERE a.grafana_login NOT LIKE 'test_%'\n  AND a.grafana_login NOT IN ('dan', 'matt')\nGROUP BY a.grafana_login\nORDER BY MAX(a.last_seen_at) DESC;",
          "refId": "A"
        }
      ],
      "title": "Account Activity Summary",
      "type": "table"
