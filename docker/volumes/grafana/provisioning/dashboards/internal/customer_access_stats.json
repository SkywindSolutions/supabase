          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  INITCAP(REPLACE(REPLACE(grafana_login, 'test_', ''), '_', ' ')) AS \"Account\",\n  MAX(last_seen_at) AS \"Last Seen\",\n  EXTRACT(DAY FROM now() - MAX(last_seen_at))::integer AS \"Days Inactive\"\nFROM public.grafana_access_log\nWHERE grafana_login NOT LIKE 'test_%'\n  AND grafana_login NOT IN ('dan', 'matt')\nGROUP BY grafana_login\nHAVING MAX(last_seen_at) < now() - INTERVAL '7 days'\nORDER BY MAX(last_seen_at) ASC;",
          "refId": "A"
        }
      ],
      "title": "Inactive Accounts (>7 days)",
      "type": "table"
