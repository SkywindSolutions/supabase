          "rawSql": "SELECT\n  gd.timestamp AS \"time\",\n  AVG(gd.probability) AS domain_avg,\n  MAX(gd.probability) AS domain_max,\n  MIN(gd.probability) AS domain_min\nFROM forecast_grid_data gd\nWHERE\n  gd.group_id = '$group_id'\n  AND gd.model = '$model'\n  AND gd.probability IS NOT NULL\n  AND $__timeFilter(gd.timestamp)\nGROUP BY gd.timestamp\nORDER BY gd.timestamp",
