          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected_run AS (\n  SELECT MAX(startdt) AS startdt\n  FROM forecast_data\n  WHERE startdt <= NOW()::timestamptz\n    AND pot IS NOT NULL\n    AND group_id = 'grp_oceanCay'\n    AND model = 'wind_nbm'\n)\nSELECT\n  pot\nFROM forecast_data\nWHERE\n  pot IS NOT NULL\n  AND group_id = 'grp_oceanCay'\n  AND model = 'wind_nbm'\n  AND startdt = (SELECT startdt FROM selected_run)\nORDER BY\n  CASE WHEN locname = '$location' THEN 0 ELSE 1 END,\n  timestamp DESC\nLIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Prob of Thunderstorms",
