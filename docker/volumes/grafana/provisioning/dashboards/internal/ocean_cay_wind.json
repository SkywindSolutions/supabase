          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT timestamp AS ts\n  FROM forecast_data\n  WHERE windspdmean IS NOT NULL\n    AND locname = '$location'\n    AND group_id = 'grp_oceanCay'\n    AND model = '$model'\n    AND (height_m IN (20, 60) OR height_m IS NULL)\n    AND timestamp <= NOW()::TIMESTAMPTZ\n  ORDER BY timestamp DESC, startdt DESC NULLS LAST, CASE WHEN height_m = 20 OR height_m IS NULL THEN 0 ELSE 1 END\n  LIMIT 1\n)\nSELECT\n  to_char(ts AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI \"UTC\"')\n  || ' | '\n  || to_char(ts AT TIME ZONE '$location_tz', 'YYYY-MM-DD HH24:MI \"Local\"') AS \"Current Time\"\nFROM latest",
          "refId": "A"
        }
      ],
      "title": "",
      "type": "stat"
    },
