          "rawSql": "SELECT group_name AS \"Group\", locname AS \"Location\", product AS \"Product\", model AS \"Model\",\n       overall_status AS \"Overall\", forecast_status AS \"Forecast Status\", run_status AS \"Run Status\",\n       observation_status AS \"Observation Status\", ingest_status AS \"Ingest Status\",\n       ROUND(forecast_horizon_hours::numeric, 1) AS \"Horizon (h)\",\n       newer_empty_runs AS \"Newer Empty Runs\", missing_primary_rows AS \"Missing Primary\", missing_bounds_rows AS \"Missing Bounds\"\nFROM public.v_operational_forecast_status\nWHERE severity >= 2\n  AND ('$group' = '__all' OR group_id = '$group')\n  AND ('$product' = '__all' OR product = '$product')\n  AND ('$status' = '__all' OR overall_status = '$status')\nORDER BY severity DESC, group_name, locname, product, model",
