          "rawSql": "SELECT group_name AS \"Group\", locname AS \"Location\", product AS \"Product\", model AS \"Model\",\n       run_status AS \"Run Status\", latest_successful_startdt AS \"Latest Good Run\", latest_any_startdt AS \"Latest Any Run\",\n       latest_run_rows AS \"Rows\", missing_primary_rows AS \"Missing Primary\", missing_bounds_rows AS \"Missing Bounds\", newer_empty_runs AS \"Newer Empty Runs\"\nFROM public.v_operational_forecast_status\nWHERE ('$group' = '__all' OR group_id = '$group')\n  AND ('$product' = '__all' OR product = '$product')\nORDER BY CASE run_status WHEN 'CRITICAL' THEN 3 WHEN 'WARNING' THEN 2 WHEN 'NO RUN' THEN 1 ELSE 0 END DESC, group_name, locname, product, model",
