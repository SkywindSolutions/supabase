        {
          "datasource": {"type": "postgres", "uid": "supabase-postgres"},
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT group_name AS \"Group\",\n       locname AS \"Location\",\n       product AS \"Product\",\n       model AS \"Model\",\n       overall_status AS \"Overall\",\n       forecast_status AS \"Forecast Status\",\n       run_status AS \"Run Status\",\n       observation_status AS \"Observation Status\",\n       ingest_status AS \"Ingest Status\",\n       latest_successful_startdt AS \"Latest Forecast Time\",\n       forecast_horizon_hours AS \"Horizon (h)\",\n       latest_observation_time AS \"Latest Observation Time\",\n       observation_age_hours AS \"Obs Age (h)\",\n       latest_any_startdt AS \"Latest Any Run\",\n       newer_empty_runs AS \"Newer Empty Runs\",\n       latest_ingest_time AS \"Latest Ingest\",\n       verification_rows_7d AS \"Verification Rows 7d\"\nFROM public.v_operational_forecast_status\nWHERE ('$group' = '__all' OR group_id = '$group')\n  AND ('$product' = '__all' OR product = '$product')\n  AND ('$status' = '__all' OR overall_status = '$status')\nORDER BY severity DESC, group_name, locname, product, model",
          "refId": "A"
        }
      ],
      "title": "Location Product Health",
      "type": "table"
    },
