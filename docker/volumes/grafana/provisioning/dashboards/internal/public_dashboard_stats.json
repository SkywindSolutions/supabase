          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(accessed_at, '1d'),\n  dashboard_slug AS metric,\n  COUNT(*) AS value\nFROM public.public_dashboard_access_log\nWHERE $__timeFilter(accessed_at)\n  AND status_code = 200\nGROUP BY 1, 2\nORDER BY 1;",
