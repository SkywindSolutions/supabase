          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  dashboard_slug AS \"Dashboard\",\n  COUNT(*) AS \"Views\",\n  COUNT(DISTINCT visitor_hash) FILTER (WHERE visitor_hash IS NOT NULL) AS \"Unique Visitors\",\n  MAX(accessed_at) AS \"Last Seen\",\n  MIN(accessed_at) AS \"First Seen\"\nFROM public.public_dashboard_access_log\nWHERE $__timeFilter(accessed_at)\n  AND status_code = 200\nGROUP BY dashboard_slug\nORDER BY MAX(accessed_at) DESC;",
          "refId": "A"
        }
      ],
      "title": "Dashboard Summary",
      "type": "table"
