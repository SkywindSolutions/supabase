          "rawSql": "SELECT\n  LPAD(EXTRACT(HOUR FROM accessed_at)::text, 2, '0') || ':00' AS \"Hour (UTC)\",\n  COUNT(*) AS \"Views\"\nFROM public.public_dashboard_access_log\nWHERE $__timeFilter(accessed_at)\n  AND status_code = 200\nGROUP BY EXTRACT(HOUR FROM accessed_at)\nORDER BY EXTRACT(HOUR FROM accessed_at);",
