          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n  COUNT(*)::numeric /\n  NULLIF(\n    EXTRACT(DAY FROM $__to - $__from)::numeric + 1,\n    0\n  ),\n  1\n) AS \"Avg Views per Day\"\nFROM public.public_dashboard_access_log\nWHERE $__timeFilter(accessed_at)\n  AND status_code = 200;",
          "refId": "A"
        }
      ],
      "title": "Avg Views per Day",
