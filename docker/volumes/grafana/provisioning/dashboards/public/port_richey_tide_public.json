      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH nearest_points AS (\n  SELECT\n    forecastdtutc AS timestamp,\n    tidemean,\n    LEAD(forecastdtutc) OVER (ORDER BY forecastdtutc) AS next_timestamp,\n    LEAD(tidemean) OVER (ORDER BY forecastdtutc) AS next_tidemean\n  FROM forecast_data\n  WHERE\n    tidemean IS NOT NULL\n    AND locname = 'Port Richey'\n    AND group_id = 'grp_portrichey'\n    AND model = 'tide_blend'\n    AND startdt = (\n      SELECT MAX(startdt)\n      FROM forecast_data\n      WHERE startdt <= NOW()::TIMESTAMPTZ\n        AND locname = 'Port Richey'\n        AND group_id = 'grp_portrichey'\n        AND model = 'tide_blend'\n    )\n  ORDER BY forecastdtutc\n)\nSELECT\n  NOW()::TIMESTAMPTZ AS \"time\",\n  CASE\n    WHEN next_timestamp IS NULL THEN tidemean\n    WHEN NOW()::TIMESTAMPTZ >= next_timestamp THEN next_tidemean\n    ELSE tidemean + (next_tidemean - tidemean) * EXTRACT(EPOCH FROM (NOW()::TIMESTAMPTZ - timestamp)) / NULLIF(EXTRACT(EPOCH FROM (next_timestamp - timestamp)), 0)\n  END AS tidemean\nFROM nearest_points\nWHERE timestamp <= NOW()::TIMESTAMPTZ\nORDER BY timestamp DESC\nLIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Current Tide",
      "type": "stat"
    },
