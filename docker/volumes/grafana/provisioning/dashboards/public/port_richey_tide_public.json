          "rawSql": "SELECT\n  forecastdtutc AS \"Date (${__timezone})\",\n  tidemean AS \"Predicted Value\",\n  tideub AS \"Tide Upper Bound\",\n  tidelb AS \"Tide Lower Bound\"\nFROM forecast_data\nWHERE\n  tidemean IS NOT NULL\n  AND locname = 'Port Richey'\n  AND group_id = 'grp_portrichey'\n  AND model = 'tide_blend'\n  AND startdt = (\n    SELECT MAX(startdt)\n    FROM forecast_data\n    WHERE startdt <= $__timeFrom()\n      AND locname = 'Port Richey'\n      AND group_id = 'grp_portrichey'\n      AND model = 'tide_blend'\n  )\nORDER BY 1",
