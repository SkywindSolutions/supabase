          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH nearest_points AS (\n  SELECT\n    timestamp,\n    tidemean_display,\n    LEAD(timestamp) OVER (ORDER BY timestamp) AS next_timestamp,\n    LEAD(tidemean_display) OVER (ORDER BY timestamp) AS next_tidemean\n  FROM public.v_forecast_data_display\n  WHERE\n    tidemean_display IS NOT NULL\n    AND locname = '$location'\n    AND group_id = 'grp_ssamarine'\n    AND model = '$model'\n  ORDER BY timestamp\n)\nSELECT\n  NOW()::TIMESTAMPTZ AS \"time\",\n  CASE\n    WHEN next_timestamp IS NULL THEN tidemean_display\n    WHEN NOW()::TIMESTAMPTZ >= next_timestamp THEN next_tidemean\n    ELSE tidemean_display + (next_tidemean - tidemean_display) * EXTRACT(EPOCH FROM (NOW()::TIMESTAMPTZ - timestamp)) / NULLIF(EXTRACT(EPOCH FROM (next_timestamp - timestamp)), 0)\n  END AS tidemean_display\nFROM nearest_points\nWHERE timestamp <= NOW()::TIMESTAMPTZ\nORDER BY timestamp DESC\nLIMIT 1",
          "refId": "A"
        }
      ],
