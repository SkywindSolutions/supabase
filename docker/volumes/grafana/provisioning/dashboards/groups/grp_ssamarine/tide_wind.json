          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT MAX(timestamp) AS ts\n  FROM forecast_data\n  WHERE windspdmean IS NOT NULL\n    AND locname = '$location'\n    AND group_id = 'grp_ssamarine'\n    AND model = '$model'\n    AND (height_m = ${height_m:raw} OR (height_m IS NULL AND ${height_m:raw} = 10))\n    AND timestamp <= NOW()::TIMESTAMPTZ\n)\nSELECT 'UTC' AS \"Label\", to_char(ts AT TIME ZONE 'UTC', 'MM-DD HH24:MI') AS \"Time\"\nFROM latest\nWHERE ts IS NOT NULL\nUNION ALL\nSELECT 'Local' AS \"Label\", to_char(ts AT TIME ZONE '$location_tz', 'MM-DD HH24:MI') AS \"Time\"\nFROM latest\nWHERE ts IS NOT NULL",
