      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH src AS (\n  SELECT\n    timestamp AS \"time\",\n    windspdmean,\n    windspdlb,\n    windspdub,\n    winddirmean\n  FROM forecast_data\n  WHERE\n    windspdmean IS NOT NULL\n    AND locname = '$location'\n    AND group_id = 'grp_ssamarine'\n    AND model = '$model'\n    AND '$model' NOT IN ('wind_nbm', 'tide_nbm')\n    AND (height_m = ${height_m:raw} OR (height_m IS NULL AND ${height_m:raw} = 10))\n    AND $__timeFilter(timestamp)\n  UNION ALL\n  SELECT\n    forecastdtutc AS \"time\",\n    windspdmean,\n    windspdlb,\n    windspdub,\n    winddirmean\n  FROM forecast_data\n  WHERE\n    windspdmean IS NOT NULL\n    AND locname = '$location'\n    AND group_id = 'grp_ssamarine'\n    AND model = '$model'\n    AND '$model' IN ('wind_nbm', 'tide_nbm')\n    AND (height_m = ${height_m:raw} OR (height_m IS NULL AND ${height_m:raw} = 10))\n    AND startdt = (\n      SELECT MAX(startdt)\n      FROM forecast_data\n      WHERE startdt <= $__timeFrom()\n        AND locname = '$location'\n        AND group_id = 'grp_ssamarine'\n        AND model = '$model'\n        AND (height_m = ${height_m:raw} OR (height_m IS NULL AND ${height_m:raw} = 10))\n        AND windspdmean IS NOT NULL\n    )\n)\nSELECT\n  src.\"time\",\n  src.windspdmean,\n  src.windspdlb,\n  src.windspdub,\n  w.v1_s0 AS winddirmean,\n  w.v1_sm1 AS winddirmean_sm1,\n  w.v1_sp1 AS winddirmean_sp1,\n  (MOD(MOD(src.winddirmean::numeric, 360) + 360, 360))::float AS winddir_tooltip\nFROM src\nJOIN public.fn_wrap_directions(\n  (SELECT array_agg(\"time\" ORDER BY \"time\") FROM src),\n  (SELECT array_agg(winddirmean ORDER BY \"time\") FROM src)\n) w USING (\"time\")\nORDER BY src.\"time\"",
          "refId": "A"
        }
      ],
      "title": "Wind Forecast (${height_m} m)",
      "type": "timeseries",
      "description": "Wind speed forecast with predicted wind direction on the right y-axis. Direction uses wrapped shifted copies to avoid false 360-to-0 jumps."
