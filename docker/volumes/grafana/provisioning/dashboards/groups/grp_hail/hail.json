      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "supabase-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp AS \"time\",\n  hailsevere_prob AS \"Hail \u22651 in\",\n  GREATEST(0, LEAST(hailsevere_prob, hailsevere_prob * 0.4 + 0.03)) AS \"Hail \u22652 in\"\nFROM forecast_data\nWHERE\n  hailprob IS NOT NULL\n  AND locname = '$location'\n  AND group_id = 'grp_hail'\n  AND model = '$model'\n  AND $__timeFilter(timestamp)\nORDER BY timestamp",
          "refId": "A"
        }
      ],
      "title": "Hail Probability Forecast",
      "type": "timeseries"
