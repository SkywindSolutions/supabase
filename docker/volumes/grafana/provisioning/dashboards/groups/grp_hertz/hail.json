          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT MAX(startdt) AS max_startdt\n  FROM forecast_data\n  WHERE startdt <= NOW()::TIMESTAMPTZ\n    AND locname = '$location'\n    AND group_id = 'grp_hertz'\n    AND model = '$model'\n    AND (hailprob IS NOT NULL OR windprob IS NOT NULL OR tornprob IS NOT NULL)\n), src AS (\n  SELECT\n    timestamp,\n    GREATEST(\n      COALESCE(hailprob, 0),\n      COALESCE(windprob, 0),\n      COALESCE(tornprob, 0)\n    ) AS risk,\n    hailprob,\n    windprob,\n    tornprob\n  FROM forecast_data\n  WHERE\n    (hailprob IS NOT NULL OR windprob IS NOT NULL OR tornprob IS NOT NULL)\n    AND locname = '$location'\n    AND group_id = 'grp_hertz'\n    AND model = '$model'\n    AND startdt = (SELECT max_startdt FROM latest)\n    AND timestamp >= NOW()::TIMESTAMPTZ - INTERVAL '1 day'\n    AND timestamp <= NOW()::TIMESTAMPTZ + INTERVAL '4 days'\n)\nSELECT\n  MAX(risk) AS pct,\n  CASE\n    WHEN MAX(risk) < 0.10 THEN 'Very Low'\n    WHEN MAX(risk) < 0.25 THEN 'Low'\n    WHEN MAX(risk) < 0.45 THEN 'Elevated'\n    WHEN MAX(risk) < 0.70 THEN 'High'\n    WHEN MAX(risk) >= 0.70 THEN 'Very High'\n  END AS level,\n  CASE\n    WHEN MAX(risk) IS NULL THEN NULL\n    WHEN MAX(COALESCE(windprob, 0)) >= GREATEST(MAX(COALESCE(hailprob, 0)), MAX(COALESCE(tornprob, 0)))\n      THEN 'Wind'\n    WHEN MAX(COALESCE(hailprob, 0)) >= MAX(COALESCE(tornprob, 0))\n      THEN 'Hail'\n    ELSE 'Tornado'\n  END AS hazard\nFROM src\nWHERE date_trunc('day', timestamp AT TIME ZONE '$location_tz')\n    = date_trunc('day', NOW() AT TIME ZONE '$location_tz') + INTERVAL '1 days'",
          "refId": "A"
        }
      ],
