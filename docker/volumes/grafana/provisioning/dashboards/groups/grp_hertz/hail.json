          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT MAX(startdt) AS max_startdt\n  FROM forecast_data\n  WHERE startdt <= NOW()::TIMESTAMPTZ\n    AND locname = '$location'\n    AND group_id = 'grp_hertz'\n    AND model = '$model'\n    AND hailprob IS NOT NULL\n)\nSELECT\n  timestamp AS \"time\",\n  hailprob AS \"Prob of Hail\"\nFROM forecast_data\nWHERE\n  hailprob IS NOT NULL\n  AND locname = '$location'\n  AND group_id = 'grp_hertz'\n  AND model = '$model'\n  AND startdt = (SELECT max_startdt FROM latest)\n  AND $__timeFilter(timestamp)\nORDER BY timestamp",
          "refId": "A"
        }
      ],
      "title": "Hail Probability Forecast",
      "type": "timeseries"
