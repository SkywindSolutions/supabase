# Global options block.
# Disables HTTP/3 (QUIC) — Caddy auto-enables H3 for all HTTPS servers, but the
# host UDP receive buffer (416 KiB) is far below the 7 MiB QUIC requires.  Large
# Grafana JS bundles (3-4 MB each) fail repeatedly with H3_REQUEST_CANCELLED,
# causing poor first-load latency.  HTTP/2 provides equivalent multiplexing over
# TCP and is not affected by the UDP buffer constraint.
{
	servers {
		protocols h1 h2
	}
}

{$PROXY_DOMAIN} {
	# tls internal: used for self-signed cert when no domain is available (IP-based access).
	# When PROXY_DOMAIN is set to a real domain, remove this directive — Caddy will obtain
	# a Let's Encrypt certificate automatically.
	#tls internal

	@supabase_api path /auth/v1/* /rest/v1/* /graphql/v1 /realtime/v1/* /storage/v1/* /functions/v1/* /mcp

	handle @supabase_api {
		reverse_proxy kong:8000
	}

	# Supabase Studio entry point: /supabase (and /supabase/*) → Studio with prefix stripped.
	# In self-hosted mode Studio redirects / → /project/default, so the browser lands there
	# after stripping the prefix.  Credentials entered here are re-sent automatically for
	# the subsequent @studio_nav requests.
	handle_path /supabase* {
		basic_auth {
			# PROXY_AUTH_PASSWORD is overwritten with the bcrypt on startup
			{$PROXY_AUTH_USERNAME} {$PROXY_AUTH_PASSWORD}
		}
		reverse_proxy studio:3000
	}

	# Studio internal navigation paths reached after the /supabase entry point.
	# /project/* — all project pages
	# /_next/*   — Next.js static assets
	# /api/platform/* — Studio metadata API (healthcheck, profile, etc.)
	@studio_nav path /project/* /_next/* /api/platform/*

	handle @studio_nav {
		basic_auth {
			# PROXY_AUTH_PASSWORD is overwritten with the bcrypt on startup
			{$PROXY_AUTH_USERNAME} {$PROXY_AUTH_PASSWORD}
		}
		reverse_proxy studio:3000
	}

	# Alert service API — proxied before the Grafana catch-all so
	# /api/alerts/* reaches the alerts container instead of Grafana.
	handle /api/alerts/* {
		reverse_proxy alerts:8090
	}

	# Tile server — probability field GeoJSON for Grafana map overlays.
	# The Grafana Geomap geojson layer fetches directly from the browser, so
	# this route must be publicly reachable (no auth required — data is
	# aggregate probability fields, not customer PII).
	handle /geojson/* {
		encode gzip
		reverse_proxy tile-server:8080
	}

	# -----------------------------------------------------------------------
	# Public dashboard access logging
	# Logs all requests to public dashboard routes in structured JSON format
	# for downstream analytics (parsed by sync_public_dashboard_activity.py).
	# -----------------------------------------------------------------------
	@public_dashboards path /public-dashboards/*
	log @public_dashboards {
		output file /var/log/caddy/public-dashboards.log {
			roll_size 10mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# Friendly alias for the Port Richey public dashboard.
	# Grafana's SPA extracts the access token from the browser URL path and
	# uses it in follow-up API calls (/api/public/dashboards/<token>/...).
	# A single path_regexp rewrite covers both the initial page load path
	# and all subsequent API calls so Grafana always sees the real token.
	@port_richey path_regexp pr (/public-dashboards|/api/public/dashboards)/Port-Richey(.*)
	rewrite @port_richey {re.pr.1}/27539075035b4a64a0a9f2bebfcbd64d{re.pr.2}

	# Friendly alias for the public hail forecast demo dashboard.
	@hail_forecast path_regexp hf (/public-dashboards|/api/public/dashboards)/Hail-Forecast(.*)
	rewrite @hail_forecast {re.hf.1}/dcab3baeba8c468fa28339212f51818b{re.hf.2}

	# Default: Grafana at the root — Grafana manages its own login page.
	handle {
		reverse_proxy grafana:3000
	}

	header -server
}
